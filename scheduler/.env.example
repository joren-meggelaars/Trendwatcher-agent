# Copy to .env and fill in the values below.

# Base URL of the scoring-service. The scheduler talks to it only over HTTP,
# never directly to its database — so both can move to Azure independently
# (Container App / Function) later.
SCORING_SERVICE_URL=http://127.0.0.1:8000

# --- daily_digest ---

# Mail via Microsoft Graph (client-credentials/app-only), not SMTP/IMAP.
# The app registration needs application permission Mail.Send (admin
# consent) on GRAPH_TENANT_ID.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Mailbox the Graph app sends as, e.g. jorensblogbox@meggelaars.nl.
DIGEST_MAILBOX=
# Where the digest should be sent to.
DIGEST_TO_EMAIL=

# true (default): log the composed digest to the console instead of actually
# calling Graph's sendMail. Set to false once GRAPH_*/DIGEST_MAILBOX are filled in.
DIGEST_DRY_RUN=true

# Hour of day (0-23, local time of the machine running the scheduler) the
# daily digest job fires.
DIGEST_HOUR=7
# Max number of items included in the digest, highest relevance_score first.
DIGEST_TOP_N=5

# Minimum spacing (seconds) between POST /score calls, shared by all jobs. Default 0
# (no delay). Mainly useful when the scoring-service runs with
# EMBEDDING_PROVIDER=voyage on Voyage's free tier, which caps at 3 req/min
# without a payment method on file — not needed for normal/local use.
SCORE_REQUEST_DELAY_SECONDS=0

# jobs/ingest.py (fetch feeds + score) runs continuously in the background at
# this interval; the first run is one interval after startup. The daily
# digest only mails what is already scored.
INGEST_INTERVAL_MINUTES=30

# Max. number of the newest unseen entries scored per source per ingest run
# (0 = unlimited). Keeps a newly added source with a huge feed from hogging
# the scoring; older unseen entries are marked seen, not scored.
MAX_NEW_ENTRIES_PER_SOURCE=10

# The digest picks the best not-yet-mailed items scored within this many days.
DIGEST_LOOKBACK_DAYS=3

# --- weekly_discovery ---

# Day of week (APScheduler cron names: mon/tue/wed/thu/fri/sat/sun) and hour
# (0-23) the weekly discovery sweep fires.
DISCOVERY_DAY=mon
DISCOVERY_HOUR=8
# How many days back to look for "interessant"-labeled items when distilling
# search terms.
DISCOVERY_LOOKBACK_DAYS=30
# How many distilled search terms to search for, and how many results per term.
DISCOVERY_MAX_SEARCH_TERMS=5
DISCOVERY_RESULTS_PER_TERM=5

# Web search provider for the market-sweep step. Not yet decided — leave
# SEARCH_PROVIDER empty and weekly_discovery will log a warning and skip the
# search step (evaluate-all still runs). Currently implemented: "brave"
# (Brave Search API, https://api.search.brave.com). Bing Search API is the
# other candidate but has no SearchProvider implementation yet.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Where the local "already scored this RSS entry" cache is stored. Defaults
# to data/seen_items.json next to this file.
SEEN_ITEMS_PATH=

# --- mailbox_ingest ---

# Reads unread mail from DIGEST_MAILBOX and scores it — for newsletter-only
# sources with no RSS feed (tl;dr sec, Risky Business News, SANS NewsBites).
# Off by default: this needs the Graph app registration to also have
# application permission Mail.Read (admin consent), separate from Mail.Send.
MAILBOX_INGEST_ENABLED=false
MAILBOX_INGEST_FOLDER=inbox
# Safety cap per run, in case a lot of unread mail piles up.
MAILBOX_INGEST_MAX_MESSAGES=25
MAILBOX_INGEST_HOUR=6

# --- internal trigger server + settings sync ---
# Lets the admin GUI (scoring-service) trigger an immediate digest send and
# push DIGEST_HOUR/DIGEST_TOP_N changes without a restart. Only reachable
# over the internal Docker network, never published to the host.
TRIGGER_SERVER_PORT=8001
# Basis-URL van de 👍/👎-links in de digest-mail; moet vanuit je browser
# bereikbaar zijn. Leeg = SCORING_SERVICE_URL (prima bij lokaal draaien).
FEEDBACK_BASE_URL=
# "Verstuur nu"-knop: mailt de beste al gescoorde items uit de laatste N
# dagen, zonder opnieuw te scoren (dus geen wachttijd door de Voyage-limiet).
MANUAL_DIGEST_LOOKBACK_DAYS=7
SETTINGS_SYNC_INTERVAL_SECONDS=300
