# Kopieer naar .env in dezelfde map als docker-compose.yml en vul in met
# echte waarden. Dit .env-bestand wordt NOOIT gecommit (zie .gitignore) en
# wordt uitsluitend handmatig op de VM aangemaakt.
#
# Veel van de waarden hieronder (scorepauze, ingest-interval, dry-run, discovery, ...)
# kun je later ook in de admin-GUI overschrijven (/admin/config); .env blijft de
# basis. Geheimen en mail-routering (GRAPH_*, *_API_KEY, DIGEST_MAILBOX,
# DIGEST_TO_EMAIL, FEEDBACK_BASE_URL, ...) kunnen ALLEEN hier worden gewijzigd.

# --- Netwerk ---

# Het interne (LAN-)IP-adres van deze VM waarop de scoring-service/admin-GUI
# bereikbaar moet zijn. NIET 0.0.0.0 — dat bindt op elke interface van de VM,
# ook eventuele andere/publieke interfaces. Alleen dit adres binnen het eigen
# netwerk kan bij poort 8000; externe toegang loopt via de bestaande, hier
# niet betrokken reverse proxy.
BIND_ADDRESS=10.0.100.8

# --- Postgres ---

POSTGRES_USER=trendwatcher
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=trendwatcher

# Wordt door docker-compose.yml automatisch samengesteld uit de drie
# variabelen hierboven (zie de scoring-service-environment-sectie in
# docker-compose.yml) — deze regel is puur ter documentatie/voor handmatig
# gebruik (bijv. psql of pytest vanaf je eigen machine tegen de
# geëxposeerde... let op: Postgres' poort wordt in deze compose-opzet NIET
# naar de host gepubliceerd, alleen bereikbaar vanuit de andere containers
# op het gedeelde netwerk als "postgres:5432").
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- scoring-service ---

VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_MODEL=voyage-3
EMBEDDING_PROVIDER=voyage
EMBEDDING_DIM=1024
DEFAULT_USER_ID=joren

# Lokale admin-GUI (/admin/*). Genereer de hash op de VM zelf met:
#   docker compose run --rm scoring-service python -m scripts.hash_admin_password
#
# BELANGRIJK: een bcrypt-hash bevat "$"-tekens (bijv. $2b$12$...). Docker
# Compose interpreteert "$naam" in .env-waarden zelf als een variabele-
# verwijzing en vervangt 'm stilzwijgend door een lege string als die niet
# bestaat ("WARN ... variable is not set"). Verdubbel daarom elke "$" naar
# "$$" in de hash die je hier plakt, anders wordt ADMIN_PASSWORD_HASH
# stukgemaakt en kun je nooit inloggen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Onderteken-sleutel voor de sessie-cookie. Vast zetten zodat een
# container-restart ingelogde sessies niet meteen ongeldig maakt:
#   docker compose run --rm scoring-service python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Zet op true zodra de admin-GUI via HTTPS wordt bediend (reverse proxy): het
# sessie-cookie wordt dan alleen nog over HTTPS verstuurd. Laat op false zolang
# je de GUI over gewoon http op je LAN gebruikt, anders kun je niet inloggen.
SESSION_COOKIE_SECURE=false

# ALLEEN voor lokaal testen: zet de controle uit die voorkomt dat de server interne
# adressen ophaalt (batch-toevoegen, feeds, discovery). Op de VM altijd false.
SAFE_FETCH_ALLOW_PRIVATE=false

# --- scheduler: Microsoft Graph (mail) ---

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
DIGEST_MAILBOX=
DIGEST_TO_EMAIL=
# true = digest naar de scheduler-containerlogs i.p.v. echt versturen. Zet
# pas op false nadat de GRAPH_*/DIGEST_MAILBOX-waarden hierboven kloppen.
DIGEST_DRY_RUN=true
DIGEST_HOUR=7
DIGEST_TOP_N=5

# Minimale afstand (seconden) tussen POST /score-aanroepen, gedeeld door alle
# jobs die scoren. 21 zolang Voyage zonder betaalmethode draait (gratis tier:
# 3 requests/minuut); met een betaalmethode is de limiet weg en zet je dit op 0.
SCORE_REQUEST_DELAY_SECONDS=0

# Feeds ophalen en scoren draait doorlopend op de achtergrond, elke zoveel
# minuten (de eerste run een interval na de start). De digest om DIGEST_HOUR
# scoort niets meer: die mailt wat er dan al gescoord is.
INGEST_INTERVAL_MINUTES=30

# Per bron en per ingest-run worden maximaal dit aantal van de nieuwste, nog
# niet geziene feed-items gescoord (0 = onbeperkt). Voorkomt dat een nieuwe
# bron met een grote feed (NCSC: honderden, IETF: ~600) uren aan scoring
# opeist. Oudere ongeziene items worden als gezien gemarkeerd, niet gescoord.
MAX_NEW_ENTRIES_PER_SOURCE=10

# De digest kiest uit nog niet gemailde items van de laatste zoveel dagen.
DIGEST_LOOKBACK_DAYS=3

DISCOVERY_DAY=mon
DISCOVERY_HOUR=8
DISCOVERY_LOOKBACK_DAYS=30
DISCOVERY_MAX_SEARCH_TERMS=5
DISCOVERY_RESULTS_PER_TERM=5

# --- scheduler: weekly_discovery zoek-API (nog geen keuze gemaakt) ---
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- scheduler: mailbox_ingest (nieuwsbrieven zonder RSS) ---
# Staat uit totdat de Graph-appregistratie ook Mail.Read (admin consent)
# heeft naast Mail.Send.
MAILBOX_INGEST_ENABLED=false
MAILBOX_INGEST_FOLDER=inbox
MAILBOX_INGEST_MAX_MESSAGES=25
MAILBOX_INGEST_HOUR=6

# --- scheduler: interne trigger-server + instellingen-sync ---
# Alleen bereikbaar binnen het Docker-netwerk (scoring-service -> scheduler),
# niet naar de host gepubliceerd. Voor de "verstuur nu"-knop en het live
# overnemen van een gewijzigd digest-uur uit de admin-GUI.
TRIGGER_SERVER_PORT=8001
# Het adres van de admin-GUI zoals je browser het ziet. De knoppen in de
# digest-mail openen daar de digest (bijv. https://trend.voorbeeld.nl, zonder
# slash aan het eind). Moet vanuit je browser bereikbaar zijn (dus NIET
# http://scoring-service:8000). Leeg laten = http://<BIND_ADDRESS>:8000. Wordt
# ook door de GUI gebruikt om formulieren van dit adres te accepteren.
# FEEDBACK_BASE_URL=
# "Verstuur nu"-knop: mailt de beste al gescoorde items uit de laatste N
# dagen, zonder opnieuw te scoren (dus geen wachttijd door de Voyage-limiet).
MANUAL_DIGEST_LOOKBACK_DAYS=7
SETTINGS_SYNC_INTERVAL_SECONDS=300
