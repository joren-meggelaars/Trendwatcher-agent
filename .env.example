# Kopieer naar .env in dezelfde map als docker-compose.yml en vul in met
# echte waarden. Dit .env-bestand wordt NOOIT gecommit (zie .gitignore) en
# wordt uitsluitend handmatig op de VM aangemaakt.

# --- Netwerk ---

# Het interne (LAN-)IP-adres van deze VM waarop de scoring-service/admin-GUI
# bereikbaar moet zijn. NIET 0.0.0.0 — dat bindt op elke interface van de VM,
# ook eventuele andere/publieke interfaces. Alleen dit adres binnen het eigen
# netwerk kan bij poort 8000; externe toegang loopt via de bestaande, hier
# niet betrokken reverse proxy.
BIND_ADDRESS=10.0.100.8

# --- Postgres ---

POSTGRES_USER=trendwatcher
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=trendwatcher

# Wordt door docker-compose.yml automatisch samengesteld uit de drie
# variabelen hierboven (zie de scoring-service-environment-sectie in
# docker-compose.yml) — deze regel is puur ter documentatie/voor handmatig
# gebruik (bijv. psql of pytest vanaf je eigen machine tegen de
# geëxposeerde... let op: Postgres' poort wordt in deze compose-opzet NIET
# naar de host gepubliceerd, alleen bereikbaar vanuit de andere containers
# op het gedeelde netwerk als "postgres:5432").
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- scoring-service ---

VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_MODEL=voyage-3
EMBEDDING_PROVIDER=voyage
EMBEDDING_DIM=1024
DEFAULT_USER_ID=joren

# Lokale admin-GUI (/admin/*). Genereer de hash op de VM zelf met:
#   docker compose run --rm scoring-service python -m scripts.hash_admin_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Onderteken-sleutel voor de sessie-cookie. Vast zetten zodat een
# container-restart ingelogde sessies niet meteen ongeldig maakt:
#   docker compose run --rm scoring-service python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# --- scheduler: Microsoft Graph (mail) ---

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
DIGEST_MAILBOX=
DIGEST_TO_EMAIL=
# true = digest naar de scheduler-containerlogs i.p.v. echt versturen. Zet
# pas op false nadat de GRAPH_*/DIGEST_MAILBOX-waarden hierboven kloppen.
DIGEST_DRY_RUN=true
DIGEST_HOUR=7
DIGEST_TOP_N=5

# Pauze (seconden) tussen opeenvolgende POST /score-aanroepen. Nodig zodra
# EMBEDDING_PROVIDER=voyage zonder betaalmethode draait (Voyage's gratis tier
# staat maar 3 requests/minuut toe) — zonder dit loopt de dagelijkse digest
# weer tegen dezelfde TLS/rate-limit-fout aan die eerder is gedebugd.
SCORE_REQUEST_DELAY_SECONDS=0

DISCOVERY_DAY=mon
DISCOVERY_HOUR=8
DISCOVERY_LOOKBACK_DAYS=30
DISCOVERY_MAX_SEARCH_TERMS=5
DISCOVERY_RESULTS_PER_TERM=5

# --- scheduler: weekly_discovery zoek-API (nog geen keuze gemaakt) ---
SEARCH_PROVIDER=
SEARCH_API_KEY=
