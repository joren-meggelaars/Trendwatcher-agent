# Copy to .env and fill in the values below.

# SQLite for local development (default). Later, without any code changes,
# point this at PostgreSQL + pgvector instead, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./scoring.db

# Required for real embeddings. Get a key at https://www.voyageai.com/
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_MODEL=voyage-3

# "voyage" uses the real Voyage AI API (needs VOYAGE_API_KEY above).
# "fake" uses a deterministic, offline stand-in embedding — no API key
# needed, useful for local testing before you have a Voyage key.
EMBEDDING_PROVIDER=voyage

# Dimensionality of the embedding vectors. Must match the Voyage model
# above (voyage-3 = 1024). Only relevant for the future pgvector column.
EMBEDDING_DIM=1024

# Single fixed user for now; multi-user support comes in a later phase.
DEFAULT_USER_ID=joren

# --- Bronbeheer: instroom-/krimpdrempels (zie app/discovery.py) ---
SOURCE_ACTIVATION_WINDOW=5
SOURCE_ACTIVATION_MIN_HIGH_SCORE=3
SOURCE_ACTIVATION_SCORE_THRESHOLD=0.6
SOURCE_DEACTIVATION_WINDOW=10
SOURCE_DEACTIVATION_MIN_NEGATIVE=8
SOURCE_DEACTIVATION_AVG_SCORE_THRESHOLD=0.3

# --- Lokale admin-GUI (/admin/*) ---

# Eén vast account. Nooit het wachtwoord zelf hier zetten — alleen de
# bcrypt-hash. Genereer je eigen hash met:
#   uv run python -m scripts.hash_admin_password
# De placeholder-hash hieronder hoort bij het placeholder-wachtwoord
# "changeme123" — vervang 'm door je eigen hash voor gebruik.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$3n70LZMlQKqjG6gsNx0Lqe7zuarp08uuNlb0vMnai9tEhwURTXPmS

# Ondertekent de sessie-cookie. Laat leeg om bij elke processtart een
# willekeurige sleutel te genereren (veilig by default, maar bestaande
# sessies overleven dan geen herstart). Zet een vaste waarde in .env voor
# sessies die een herstart overleven, bijv. via:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
